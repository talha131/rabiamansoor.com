# Google Analytics 4 measurement ID. When unset, the GA script is NOT emitted
# (dev and preview stay clean). Set this in the Netlify UI for production.
PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: override the production URL used for canonical/OG/sitemap.
# Defaults to https://rabiamansoor.com (see astro.config.mjs).
# SITE=https://rabiamansoor.com
