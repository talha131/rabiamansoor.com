---
import { NAV, SCHOLAR_URL, ORCID_URL, DEVELOPER } from '../lib/site';
---

<footer class="footer panel--ink">
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <p class="footer__name">Rabia Mansoor</p>
      <p class="footer__role">
        Independent Researcher · PhD Scholar · Educator
      </p>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      <p class="coord coord--plain footer__eyebrow">Sections</p>
      <ul role="list">
        {NAV.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer__links">
      <p class="coord coord--plain footer__eyebrow">Scholarly index</p>
      <ul role="list">
        <li>
          <a href={SCHOLAR_URL} target="_blank" rel="noopener">Google Scholar ↗</a>
        </li>
        <li><a href={ORCID_URL} target="_blank" rel="noopener">ORCID ↗</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap footer__base">
    <p class="footer__coords">41°N · Cartography of Narrative · MMXXVI</p>
    <div class="footer__legal">
      <p class="footer__license">
        © 2026 Rabia Mansoor · Content licensed under
        <a
          href="https://creativecommons.org/licenses/by-nc-nd/4.0/"
          target="_blank"
          rel="noopener license">CC BY-NC-ND 4.0 ↗</a>
      </p>
      <p class="footer__credit">
        Developed by
        <a href={DEVELOPER.url} target="_blank" rel="noopener">{DEVELOPER.name}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    /* Bottom inset is ADDED (home indicator sits below the existing padding);
       horizontal insets are 0px unless a notch is present. */
    padding-block: var(--space-xl)
      calc(var(--space-l) + env(safe-area-inset-bottom, 0px));
    padding-inline: env(safe-area-inset-left, 0px) env(safe-area-inset-right, 0px);
    border-top: 2px solid var(--signature);
  }
  .footer__grid {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: 1fr;
    padding-bottom: var(--space-l);
    border-bottom: 1px solid var(--line-cream);
  }
  .footer__name {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
  }
  .footer__role {
    color: rgba(255, 247, 236, 0.72);
    margin-top: 0.4em;
    font-size: var(--step--1);
  }
  .footer__eyebrow {
    color: var(--amber);
    margin-bottom: 0.9em;
  }
  .footer__nav ul,
  .footer__links ul {
    display: grid;
    gap: 0.5em;
  }
  .footer__nav a,
  .footer__links a {
    /* 44px hit area without changing visual density (padding alone on inline
       links is unreliable for hit-target size). */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    color: var(--cream);
    text-underline-offset: 3px;
  }
  .footer__nav a:hover,
  .footer__links a:hover {
    text-decoration: underline;
    color: var(--amber);
  }
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }
  .footer__coords {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 247, 236, 0.5);
  }
  /* License + credit — understated small font, right-aligned on wide screens. */
  .footer__legal {
    display: grid;
    gap: 0.35em;
  }
  .footer__license,
  .footer__credit {
    font-size: 0.78rem;
    color: rgba(255, 247, 236, 0.6);
  }
  .footer__license a,
  .footer__credit a {
    /* Grow the clickable box to 44px, not the surrounding text size. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--cream);
    text-underline-offset: 2px;
  }
  .footer__license a:hover,
  .footer__credit a:hover {
    color: var(--amber);
  }

  @media (min-width: 700px) {
    .footer__legal {
      text-align: right;
    }
  }

  @media (min-width: 700px) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
</style>
