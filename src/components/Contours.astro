---
/* Decorative topographic contour lines — the recurring cartographic motif.
   Purely ornamental: aria-hidden, non-interactive, parallax-friendly.

   Each page's hero uses a DISTINCT nested-outline shape so the pages read
   apart at a glance: rings (home), diamond (journal), trapezoid (lab),
   hexagon (classroom), square (about), pentagon (writing). ridge/route are
   shared line motifs used for secondary section decoration. */
interface Props {
  variant?: 'rings' | 'diamond' | 'trapezoid' | 'hexagon' | 'square' | 'pentagon' | 'ridge' | 'route';
  class?: string;
  parallax?: number | null;
  opacity?: number;
  color?: string; // CSS color/var; defaults to currentColor
}
const {
  variant = 'rings',
  class: klass = '',
  parallax = null,
  opacity = 0.5,
  color = 'currentColor',
} = Astro.props;

const parallaxAttr =
  parallax === null ? {} : { 'data-parallax': String(parallax) };

// Shared geometry for the nested-outline shapes.
const CX = 200;
const CY = 200;
const R = [180, 150, 120, 92, 66, 42, 22];
const dash = (i: number) => (i % 2 ? '4 6' : undefined);
const weight = (i: number) => (i === 2 ? 2 : 1);

const diamondPts = (r: number) =>
  `${CX},${CY - r} ${CX + r},${CY} ${CX},${CY + r} ${CX - r},${CY}`;

// Isosceles trapezoid, narrower at the top.
const trapPts = (r: number) =>
  `${CX - 0.55 * r},${CY - r} ${CX + 0.55 * r},${CY - r} ${CX + r},${CY + r} ${CX - r},${CY + r}`;

// Flat-top hexagon.
const hexPts = (r: number) =>
  [30, 90, 150, 210, 270, 330]
    .map((a) => {
      const rad = (a * Math.PI) / 180;
      return `${(CX + r * Math.cos(rad)).toFixed(1)},${(CY + r * Math.sin(rad)).toFixed(1)}`;
    })
    .join(' ');

// Point-up pentagon.
const pentaPts = (r: number) =>
  [-90, -18, 54, 126, 198]
    .map((a) => {
      const rad = (a * Math.PI) / 180;
      return `${(CX + r * Math.cos(rad)).toFixed(1)},${(CY + r * Math.sin(rad)).toFixed(1)}`;
    })
    .join(' ');
---

<div
  class:list={['contours', `contours--${variant}`, klass]}
  style={`--c-opacity:${opacity}; color:${color};`}
  aria-hidden="true"
  {...parallaxAttr}
>
  {
    variant === 'rings' && (
      <svg viewBox="0 0 400 400" fill="none" preserveAspectRatio="xMidYMid meet">
        {R.map((r, i) => (
          <circle cx={CX} cy={CY} r={r} stroke={color} stroke-width={weight(i)} stroke-dasharray={dash(i)} />
        ))}
        <circle cx={CX} cy={CY} r="3" fill={color} stroke="none" />
      </svg>
    )
  }
  {
    variant === 'diamond' && (
      <svg viewBox="0 0 400 400" fill="none" preserveAspectRatio="xMidYMid meet">
        {R.map((r, i) => (
          <polygon points={diamondPts(r)} stroke={color} stroke-width={weight(i)} stroke-dasharray={dash(i)} stroke-linejoin="round" />
        ))}
        <circle cx={CX} cy={CY} r="3" fill={color} stroke="none" />
      </svg>
    )
  }
  {
    variant === 'trapezoid' && (
      <svg viewBox="0 0 400 400" fill="none" preserveAspectRatio="xMidYMid meet">
        {R.map((r, i) => (
          <polygon points={trapPts(r)} stroke={color} stroke-width={weight(i)} stroke-dasharray={dash(i)} stroke-linejoin="round" />
        ))}
        <circle cx={CX} cy={CY} r="3" fill={color} stroke="none" />
      </svg>
    )
  }
  {
    variant === 'hexagon' && (
      <svg viewBox="0 0 400 400" fill="none" preserveAspectRatio="xMidYMid meet">
        {R.map((r, i) => (
          <polygon points={hexPts(r)} stroke={color} stroke-width={weight(i)} stroke-dasharray={dash(i)} stroke-linejoin="round" />
        ))}
        <circle cx={CX} cy={CY} r="3" fill={color} stroke="none" />
      </svg>
    )
  }
  {
    variant === 'pentagon' && (
      <svg viewBox="0 0 400 400" fill="none" preserveAspectRatio="xMidYMid meet">
        {R.map((r, i) => (
          <polygon points={pentaPts(r)} stroke={color} stroke-width={weight(i)} stroke-dasharray={dash(i)} stroke-linejoin="round" />
        ))}
        <circle cx={CX} cy={CY} r="3" fill={color} stroke="none" />
      </svg>
    )
  }
  {
    variant === 'square' && (
      <svg viewBox="0 0 400 400" fill="none" preserveAspectRatio="xMidYMid meet">
        {R.map((r, i) => (
          <rect x={CX - r} y={CY - r} width={2 * r} height={2 * r} rx="6" stroke={color} stroke-width={weight(i)} stroke-dasharray={dash(i)} />
        ))}
        <circle cx={CX} cy={CY} r="3" fill={color} stroke="none" />
      </svg>
    )
  }
  {
    variant === 'ridge' && (
      <svg viewBox="0 0 600 300" fill="none" preserveAspectRatio="none">
        {[0, 26, 52, 80, 110, 144].map((o) => (
          <path
            d={`M0 ${240 - o} C 120 ${180 - o}, 200 ${260 - o}, 320 ${190 - o} S 520 ${150 - o}, 600 ${210 - o}`}
            stroke={color}
            stroke-width="1.5"
          />
        ))}
      </svg>
    )
  }
  {
    variant === 'route' && (
      <svg viewBox="0 0 400 600" fill="none" preserveAspectRatio="xMidYMid meet">
        <path
          d="M40 20 C 40 140, 340 180, 340 300 S 60 420, 200 580"
          stroke={color}
          stroke-width="2"
          stroke-dasharray="2 10"
          stroke-linecap="round"
        />
        {[[40, 20], [340, 300], [200, 580]].map(([x, y]) => (
          <circle cx={x} cy={y} r="6" fill="none" stroke={color} stroke-width="2" />
        ))}
      </svg>
    )
  }
</div>

<style>
  .contours {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .contours svg {
    width: 100%;
    height: 100%;
    opacity: var(--c-opacity);
  }
</style>
